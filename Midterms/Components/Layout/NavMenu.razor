<header class="sticky top-0 z-40 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-white">
            <span class="text-2xl">🍿</span>
            <span>Popcorn<span class="text-violet-400">Vault</span></span>
        </a>

        <div class="flex items-center gap-1">
            <NavLink href="" Match="NavLinkMatch.All" class="@LinkBase" ActiveClass="bg-zinc-800! text-white!">
                Dashboard
            </NavLink>
            <NavLink href="library" class="@LinkBase" ActiveClass="bg-zinc-800! text-white!">
                Library
            </NavLink>
            <NavLink href="add" class="@AddBase" ActiveClass="bg-violet-500! text-white!">
                + Add New
            </NavLink>
        </div>
    </nav>
</header>

@code {
    private const string LinkBase =
        "rounded-lg px-3.5 py-2 text-sm font-medium text-zinc-400 transition hover:bg-zinc-800/70 hover:text-white";

    private const string AddBase =
        "ml-2 rounded-lg bg-violet-600 px-3.5 py-2 text-sm font-semibold text-white shadow-lg shadow-violet-600/20 transition hover:bg-violet-500";
}
