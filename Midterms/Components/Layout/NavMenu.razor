<header class="sticky top-0 z-40 border-b-2 border-white/80 bg-white/60 backdrop-blur-lg">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="/" class="group flex items-center gap-2 text-xl font-extrabold tracking-tight text-stone-700">
            <span class="inline-block text-2xl group-hover:animate-wiggle">🍿</span>
            <span>Popcorn<span class="bg-linear-to-r from-pink-400 to-orange-400 bg-clip-text text-transparent">Vault</span></span>
        </a>

        <div class="flex items-center gap-1.5">
            <NavLink href="" Match="NavLinkMatch.All" class="@LinkBase" ActiveClass="bg-pink-200! text-pink-700!">
                🏠 Home
            </NavLink>
            <NavLink href="library" class="@LinkBase" ActiveClass="bg-pink-200! text-pink-700!">
                📚 Library
            </NavLink>
            <NavLink href="add" class="@AddBase" ActiveClass="ring-4 ring-pink-200">
                ＋ Add
            </NavLink>
        </div>
    </nav>
</header>

@code {
    private const string LinkBase =
        "rounded-full px-4 py-2 text-sm font-bold text-stone-500 transition hover:bg-pink-100 hover:text-pink-600";

    private const string AddBase =
        "ml-1 rounded-full bg-linear-to-r from-pink-400 to-orange-300 px-4 py-2 text-sm font-bold text-white shadow-md shadow-pink-300/50 transition hover:-translate-y-0.5 hover:shadow-lg";
}
