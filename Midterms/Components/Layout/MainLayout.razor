@inherits LayoutComponentBase

<div class="min-h-screen bg-[#FBF7F4] text-stone-800">
    <!-- Ambient Background Glows -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-40 left-1/4 h-96 w-96 rounded-full bg-amber-200/40 blur-3xl"></div>
        <div class="absolute top-1/3 -right-20 h-96 w-96 rounded-full bg-amber-300/30 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-orange-200/30 blur-3xl"></div>
    </div>

    <header class="sticky top-0 z-40 border-b border-amber-900/10 bg-[#FBF7F4]/90 backdrop-blur-md">
        <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
            <a href="/" class="group flex items-center gap-2.5 text-lg font-bold tracking-tight text-stone-800">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 text-xl border border-amber-200/80 transition group-hover:scale-105 shadow-sm">🍿</span>
                <span class="font-extrabold tracking-tight">Popcorn<span class="text-amber-700">Vault</span></span>
            </a>

            <div class="flex items-center gap-2">
                <NavLink href="" Match="NavLinkMatch.All" class="@LinkBase" ActiveClass="bg-amber-200/80 text-amber-950! border-amber-300 shadow-sm">
                    Dashboard
                </NavLink>
                <NavLink href="library" class="@LinkBase" ActiveClass="bg-amber-200/80 text-amber-950! border-amber-300 shadow-sm">
                    Library
                </NavLink>
                <NavLink href="add" class="@AddBase" ActiveClass="ring-2 ring-amber-500">
                    ＋ Add Title
                </NavLink>
            </div>
        </nav>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8">
        @Body
    </main>

    <footer class="border-t border-amber-900/10 py-8 text-center text-xs font-semibold text-stone-500">
        PopcornVault &bull; Warm Media & Backlog Tracker
    </footer>
</div>

@code {
    private const string LinkBase =
        "rounded-xl border border-transparent px-4 py-2 text-sm font-bold text-stone-700 transition hover:bg-amber-100 hover:text-amber-900";

    private const string AddBase =
        "ml-1 rounded-xl bg-amber-700 px-4 py-2 text-sm font-bold text-white shadow-md shadow-amber-900/10 transition hover:bg-amber-800 active:scale-95";
}