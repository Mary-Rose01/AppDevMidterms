@inherits LayoutComponentBase

<div class="min-h-screen">
    <NavMenu />
    <main class="mx-auto max-w-6xl px-6 py-10">
        @Body
    </main>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 z-50 hidden bg-red-900 px-6 py-3 text-sm text-red-100">
    An unhandled error has occurred.
    <a href="" class="reload ml-2 underline">Reload</a>
    <span class="dismiss float-right cursor-pointer">🗙</span>
</div>
