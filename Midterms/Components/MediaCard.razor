@using Midterms.Models

<article @onmouseleave="() => confirmDelete = false" class="@RootClass">

    <div class="relative aspect-[2/3] overflow-hidden rounded-xl bg-stone-200">
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-3 text-center bg-gradient-to-br from-amber-100 to-amber-200">
            <span class="text-4xl">@(Item is Movie ? "🎬" : "🎮")</span>
            <span class="line-clamp-2 text-xs font-extrabold text-amber-900">@DisplayTitle</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Item.PosterUrl))
        {
            <img src="@Item.PosterUrl" alt="@Item.Title" loading="lazy" referrerpolicy="no-referrer"
                 onerror="this.style.display='none'"
                 class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-105" />
        }

        <span class="absolute left-2 top-2 rounded-lg bg-stone-900/80 px-2 py-0.5 text-[10px] font-extrabold text-white backdrop-blur-md">
            @Item.GetMediaBadge()
        </span>

        <span class="absolute right-2 top-2 inline-flex items-center gap-1.5 rounded-lg bg-white/95 px-2 py-0.5 text-[10px] font-extrabold backdrop-blur-md shadow-sm @PillText">
            <span class="relative flex h-1.5 w-1.5">
                @if (Item.Status == "In Progress")
                {
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-75"></span>
                }
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full @DotClass"></span>
            </span>
            @Item.Status
        </span>
    </div>

    <div class="flex flex-1 flex-col p-2.5">
        <h3 class="line-clamp-1 text-xs font-extrabold leading-snug text-stone-800 transition group-hover:text-amber-700">@DisplayTitle</h3>
        <p class="mt-0.5 min-h-3 text-[11px] font-semibold text-stone-500">@Subtitle</p>

        <div class="mt-2 flex gap-0.5">
            @foreach (var n in Enumerable.Range(1, 5))
            {
                var star = n;
                <button type="button" disabled="@Preview" @onclick="() => Rate(star)"
                        class="text-sm leading-none transition hover:scale-125 disabled:cursor-default disabled:hover:scale-100 @(star <= Item.Rating ? "text-amber-500" : "text-stone-300")">
                    ★
                </button>
            }
        </div>

        @if (!Preview)
        {
            <div class="mt-3 flex gap-1.5">
                <button type="button" @onclick="Advance"
                        class="flex-1 rounded-xl bg-amber-700 px-2.5 py-1.5 text-[11px] font-extrabold text-white shadow-sm transition hover:bg-amber-800">
                    @AdvanceLabel
                </button>
                <button type="button" @onclick="Delete"
                        class="rounded-xl px-2.5 py-1.5 text-[11px] font-bold transition @(confirmDelete ? "bg-rose-600 text-white" : "bg-stone-200/70 text-stone-600 hover:bg-rose-100 hover:text-rose-700")">
                    @(confirmDelete ? "Confirm?" : "🗑")
                </button>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public MediaItem Item { get; set; } = default!;
    [Parameter] public bool Preview { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<MediaItem> OnDelete { get; set; }

    private static readonly string[] Cycle = { "Backlog", "In Progress", "Completed" };
    private bool confirmDelete;

    private async Task Advance()
    {
        Item.Status = Cycle[(Array.IndexOf(Cycle, Item.Status) + 1) % Cycle.Length];
        await OnChanged.InvokeAsync();
    }

    private async Task Rate(int n)
    {
        if (Preview) return;
        Item.Rating = Item.Rating == n ? 0 : n;
        await OnChanged.InvokeAsync();
    }

    private async Task Delete()
    {
        if (!confirmDelete) { confirmDelete = true; return; }
        await OnDelete.InvokeAsync(Item);
    }

    private string RootClass =>
        "group relative flex flex-col rounded-2xl border border-amber-900/10 bg-[#FFFDFB] p-2 shadow-sm transition duration-300 "
        + (Preview ? "" : "hover:-translate-y-1 hover:border-amber-300 hover:shadow-md");

    private string DisplayTitle => string.IsNullOrWhiteSpace(Item.Title) ? "Untitled Media" : Item.Title;

    private string AdvanceLabel => Item.Status switch
    {
        "Backlog"     => "▶ Start",
        "In Progress" => "✓ Done",
        _             => "↺ Again"
    };

    private string Subtitle => Item switch
    {
        Movie m => string.Join(" • ", new[] { m.Director, m.RuntimeMinutes > 0 ? $"{m.RuntimeMinutes}m" : "" }
                       .Where(s => !string.IsNullOrWhiteSpace(s))),
        VideoGame g => g.Platform,
        _ => ""
    };

    private string PillText => Item.Status switch
    {
        "Completed"   => "text-emerald-700",
        "In Progress" => "text-amber-800",
        _             => "text-amber-900"
    };

    private string DotClass => Item.Status switch
    {
        "Completed"   => "bg-emerald-600",
        "In Progress" => "bg-amber-600",
        _             => "bg-amber-700"
    };
}