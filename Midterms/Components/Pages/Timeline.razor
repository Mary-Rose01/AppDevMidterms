@page "/timeline"
@rendermode InteractiveServer
@using Midterms.Models
@using Midterms.Services
@inject MediaTrackerService Tracker

<PageTitle>Timeline • PopcornVault</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-stone-800 sm:text-4xl">Timeline 🕰️</h1>
    <p class="mt-2 text-sm font-medium text-stone-500">Every title you added, started, and finished, newest first.</p>
</div>

<!-- Filter Chips -->
<div class="mb-8 flex flex-wrap items-center gap-2.5 border-b border-stone-200/80 pb-5">
    @foreach (var k in Kinds)
    {
        var kind = k;
        <button @onclick="() => filter = kind" class="@Chip(filter == kind)">@kind</button>
    }
</div>

@{ var groups = Events.GroupBy(e => new DateTime(e.When.Year, e.When.Month, 1)).ToList(); }

@if (groups.Count == 0)
{
    <div class="my-8 rounded-2xl border border-dashed border-amber-300/80 bg-amber-50/30 py-20 text-center shadow-xs">
        <p class="text-4xl">🔎</p>
        <p class="mt-3 text-sm font-semibold text-stone-600">No events found for this filter.</p>
    </div>
}
else
{
    <div class="space-y-10">
        @foreach (var g in groups)
        {
            <div>
                <h2 class="mb-4 text-xs font-bold uppercase tracking-wider text-amber-900/80">
                    📅 @g.Key.ToString("MMMM yyyy")
                </h2>
                
                <div class="relative ml-4 space-y-5 border-l-2 border-amber-200/80 pl-8">
                    @foreach (var e in g)
                    {
                        <div class="relative">
                            <!-- Timeline Dot Indicator -->
                            <span class="absolute -left-[49px] top-3.5 flex h-8 w-8 items-center justify-center rounded-full border-2 border-white text-xs font-black text-white shadow-xs @DotClass(e.Kind)">
                                @Icon(e.Kind)
                            </span>

                            <!-- Event Card -->
                            <div class="flex flex-col gap-3 rounded-2xl border border-stone-200/80 bg-white p-5 shadow-xs transition duration-150 hover:border-amber-300 hover:shadow-md sm:flex-row sm:items-center sm:justify-between">
                                <div class="space-y-1">
                                    <div class="flex items-center gap-2 text-base font-bold text-stone-800">
                                        <span>@e.Item.GetMediaBadge()</span>
                                        <span>@e.Item.Title</span>
                                    </div>
                                    <p class="text-xs font-medium text-stone-500">
                                        <span class="font-semibold text-stone-700">@Label(e.Kind)</span>
                                        <span class="mx-1.5 text-stone-300">•</span>
                                        <span>@e.When.ToString("MMM d, yyyy")</span>
                                    </p>
                                </div>

                                <div class="shrink-0">
                                    <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-bold text-amber-800 ring-1 ring-inset ring-amber-600/10">
                                        @Ago(e.When)
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private record TimelineEvent(DateTime When, string Kind, MediaItem Item);

    private static readonly string[] Kinds = { "All", "Added", "Started", "Completed" };

    private List<MediaItem> items = new();
    private string filter = "All";

    protected override void OnInitialized() => items = Tracker.GetAllMedia().ToList();

    private IEnumerable<TimelineEvent> Events
    {
        get
        {
            var list = new List<TimelineEvent>();
            foreach (var i in items)
            {
                list.Add(new TimelineEvent(i.AddedOn, "Added", i));
                if (i.StartedOn.HasValue) list.Add(new TimelineEvent(i.StartedOn.Value, "Started", i));
                if (i.CompletedOn.HasValue) list.Add(new TimelineEvent(i.CompletedOn.Value, "Completed", i));
            }
            return list
                .Where(e => filter == "All" || e.Kind == filter)
                .OrderByDescending(e => e.When);
        }
    }

    private static string Label(string kind) => kind switch
    {
        "Added"   => "Added to backlog",
        "Started" => "Started watching/reading",
        _         => "Completed"
    };

    private static string Icon(string kind) => kind switch
    {
        "Added"   => "+",
        "Started" => "▶",
        _         => "✓"
    };

    private static string DotClass(string kind) => kind switch
    {
        "Added"   => "bg-stone-400",
        "Started" => "bg-amber-600",
        _         => "bg-emerald-600"
    };

    private static string Ago(DateTime d)
    {
        var days = (DateTime.Now.Date - d.Date).Days;
        return days switch { 0 => "Today", 1 => "Yesterday", _ => $"{days} days ago" };
    }

    private static string Chip(bool active) => active
        ? "rounded-xl bg-amber-700 px-4 py-2 text-xs font-bold text-white shadow-xs transition"
        : "rounded-xl bg-white border border-stone-200 px-4 py-2 text-xs font-semibold text-stone-600 transition hover:bg-stone-50 hover:text-stone-900";
}