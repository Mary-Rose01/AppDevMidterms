@page "/wrapped"
@rendermode InteractiveServer
@using Midterms.Models
@using Midterms.Services
@inject MediaTrackerService Tracker

<PageTitle>Wrapped • PopcornVault</PageTitle>

<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-stone-800">Your Vault Wrapped 🎁</h1>
        <p class="mt-1 text-xs font-semibold text-stone-500">A year in review of everything you finished.</p>
    </div>
    <select @bind="year"
            class="rounded-xl border border-stone-300 bg-white px-3 py-2 text-xs font-bold text-stone-800 shadow-xs outline-none transition focus:border-amber-500">
        @foreach (var y in Years)
        {
            <option value="@y">@y</option>
        }
    </select>
</div>

@if (Done.Count == 0)
{
    <div class="rounded-2xl border border-dashed border-amber-300 bg-white py-20 text-center shadow-xs">
        <p class="text-4xl">🎞️</p>
        <p class="mt-3 text-sm font-bold text-stone-700">Nothing completed in @year yet.</p>
        <a href="library" class="mt-4 inline-block rounded-xl bg-amber-700 px-5 py-2 text-xs font-extrabold text-white transition hover:bg-amber-800 shadow-xs">
            Go To Library
        </a>
    </div>
}
else
{
    <section class="rounded-3xl border border-amber-300 bg-gradient-to-br from-amber-600 via-amber-700 to-orange-800 p-8 text-white shadow-lg">
        <p class="text-xs font-extrabold uppercase tracking-widest text-amber-100">@year in review</p>
        <h2 class="mt-2 text-4xl font-extrabold">@Persona</h2>
        <p class="mt-2 text-sm font-semibold text-amber-100">You finished @Done.Count title@(Done.Count == 1 ? "" : "s") this year.</p>
    </section>

    <section class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
        @foreach (var t in Tiles)
        {
            <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs transition duration-300 hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-extrabold uppercase tracking-wider text-amber-900/70">@t.Label</p>
                    <span class="text-xl">@t.Icon</span>
                </div>
                <p class="mt-3 text-3xl font-extrabold text-stone-800">@t.Value</p>
            </div>
        }
    </section>

    <section class="mt-6 grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
            <p class="text-xs font-extrabold uppercase tracking-wider text-amber-900/70">Favorite Genre 💛</p>
            <p class="mt-2 text-2xl font-extrabold text-stone-800">@(FavGenre ?? "—")</p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
            <p class="text-xs font-extrabold uppercase tracking-wider text-amber-900/70">Busiest Month 📅</p>
            <p class="mt-2 text-2xl font-extrabold text-stone-800">@(BusiestMonth ?? "—")</p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
            <p class="text-xs font-extrabold uppercase tracking-wider text-amber-900/70">Top Pick 👑</p>
            @if (TopPick is { } top)
            {
                <div class="mt-3 flex items-center gap-4">
                    <div class="w-28 shrink-0">
                        <MediaCard Item="top" Preview="true" />
                    </div>
                    <div>
                        <p class="text-lg font-extrabold text-stone-800">@top.Title</p>
                        <p class="text-xs font-semibold text-stone-500">Finished @top.CompletedOn?.ToString("MMM d")</p>
                    </div>
                </div>
            }
            else
            {
                <p class="mt-2 text-sm font-bold text-stone-500">Rate something to crown a top pick.</p>
            }
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
            <p class="text-xs font-extrabold uppercase tracking-wider text-amber-900/70">Longest Backlog Survivor 🕸️</p>
            @if (Survivor is { } s)
            {
                <p class="mt-2 text-lg font-extrabold text-stone-800">@s.Title</p>
                <p class="text-xs font-semibold text-stone-500">Waiting for @((DateTime.Now - s.AddedOn).Days) days and counting.</p>
            }
            else
            {
                <p class="mt-2 text-sm font-bold text-emerald-700">Backlog cleared! 🎉</p>
            }
        </div>
    </section>

    <section class="mt-8 rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
        <h2 class="mb-3 text-lg font-extrabold text-stone-800">Everything You Finished</h2>
        <div class="divide-y divide-stone-100">
            @foreach (var i in Done.OrderByDescending(d => d.CompletedOn))
            {
                <div class="flex items-center justify-between gap-3 py-2.5 text-xs font-bold">
                    <span class="text-stone-800">@i.GetMediaBadge() &nbsp;@i.Title</span>
                    <span class="text-amber-500">@Stars(i.Rating)</span>
                    <span class="text-stone-500">@i.CompletedOn?.ToString("MMM d")</span>
                </div>
            }
        </div>
    </section>
}

@code {
    private List<MediaItem> items = new();
    private int year = DateTime.Now.Year;

    protected override void OnInitialized() => items = Tracker.GetAllMedia().ToList();

    private List<MediaItem> Done =>
        items.Where(i => i.CompletedOn?.Year == year).OrderBy(i => i.CompletedOn).ToList();

    private IEnumerable<int> Years =>
        items.Where(i => i.CompletedOn.HasValue)
             .Select(i => i.CompletedOn!.Value.Year)
             .Append(DateTime.Now.Year)
             .Distinct()
             .OrderByDescending(y => y);

    private int TotalMinutes => Done.OfType<Movie>().Sum(m => m.RuntimeMinutes);
    private string WatchTime => $"{TotalMinutes / 60}h {TotalMinutes % 60}m";

    private double? AvgRating
    {
        get
        {
            var rated = Done.Where(i => i.Rating > 0).ToList();
            return rated.Count == 0 ? null : rated.Average(i => i.Rating);
        }
    }

    private string? FavGenre => Done
        .Where(i => !string.IsNullOrWhiteSpace(i.Genre))
        .GroupBy(i => i.Genre)
        .OrderByDescending(g => g.Count())
        .Select(g => g.Key)
        .FirstOrDefault();

    private MediaItem? TopPick => Done
        .Where(i => i.Rating > 0)
        .OrderByDescending(i => i.Rating)
        .ThenByDescending(i => i.CompletedOn)
        .FirstOrDefault();

    private MediaItem? Survivor => items
        .Where(i => i.Status == "Backlog")
        .OrderBy(i => i.AddedOn)
        .FirstOrDefault();

    private string? BusiestMonth
    {
        get
        {
            var g = Done.GroupBy(i => i.CompletedOn!.Value.Month)
                        .OrderByDescending(x => x.Count())
                        .FirstOrDefault();
            return g is null
                ? null
                : $"{System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(g.Key)} ({g.Count()})";
        }
    }

    private string Persona
    {
        get
        {
            int movies = Done.Count(i => i is Movie);
            int games = Done.Count(i => i is VideoGame);
            if (movies > games) return "The Cinephile 🎬";
            if (games > movies) return "The Grinder 🎮";
            return "The Balanced Hero ⚖️";
        }
    }

    private IEnumerable<(string Label, string Value, string Icon)> Tiles => new[]
    {
        ("Titles Finished", Done.Count.ToString(), "🏆"),
        ("Movie Time", WatchTime, "🎬"),
        ("Games Beaten", Done.Count(i => i is VideoGame).ToString(), "🎮"),
        ("Avg Rating", AvgRating is null ? "—" : $"{AvgRating:0.0} ★", "⭐")
    };

    private static string Stars(int r) => r <= 0 ? "unrated" : new string('★', r);
}