@page "/"
@rendermode InteractiveServer
@using Midterms.Models
@using Midterms.Services
@inject MediaTrackerService Tracker

<PageTitle>Dashboard • PopcornVault</PageTitle>

<div class="mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-stone-800">
        Dashboard
    </h1>
    <p class="mt-1 text-xs font-semibold text-stone-500">Welcome back! Track and manage your media collection.</p>
</div>

<section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    @foreach (var s in Stats)
    {
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs transition duration-300 hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-md">
            <div class="flex items-center justify-between">
                <p class="text-xs font-extrabold uppercase tracking-wider text-amber-900/70">@s.Label</p>
                <span class="text-xl">@s.Icon</span>
            </div>
            <p class="mt-3 text-3xl font-extrabold text-stone-800">@s.Value</p>
        </div>
    }
</section>

<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-bold">
        <span class="text-stone-700">Overall Progress</span>
        <span class="text-stone-500">
            🎬 @MovieCount movies &bull; 🎮 @GameCount games &bull; <span class="text-emerald-700 font-extrabold">@Percent% Completed</span>
        </span>
    </div>
    <div class="mt-3 h-3 overflow-hidden rounded-full bg-stone-100 border border-stone-200">
        <div class="h-full rounded-full bg-amber-600 transition-all duration-700"
             style="width:@Percent%"></div>
    </div>
</section>

<section class="mt-8 rounded-2xl border border-amber-200/80 bg-gradient-to-br from-[#FFFDFB] via-[#FAF1E6] to-[#F3E8D8] p-6 shadow-xs">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
            <h2 class="text-xl font-extrabold text-stone-800">Backlog Decision Maker</h2>
            <p class="mt-1 text-xs font-semibold text-stone-600">Let PopcornVault pick a random item from your backlog.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            @foreach (var t in PickTypes)
            {
                var type = t;
                <button @onclick="() => pickType = type" class="@Chip(pickType == type)">@type</button>
            }
            <button @onclick="Pick" disabled="@rolling"
                    class="ml-2 rounded-xl bg-amber-700 px-5 py-2 text-xs font-extrabold text-white shadow-md transition hover:bg-amber-800 active:scale-95 disabled:opacity-50">
                <span class="inline-block @(rolling ? "animate-spin" : "")">🎲</span>
                @(rolling ? "Selecting…" : picked is null ? "Pick For Me" : "Re-roll")
            </button>
        </div>
    </div>

    @if (noBacklog)
    {
        <p class="mt-6 rounded-xl border border-amber-200 bg-white/80 p-4 text-xs font-bold text-stone-600">
            No items available in the backlog for this filter.
        </p>
    }
    else if (picked is not null)
    {
        <div class="mt-6 flex flex-col items-center gap-6 rounded-xl border border-amber-300 bg-white p-6 sm:flex-row shadow-xs">
            <div class="w-44 shrink-0">
                <MediaCard Item="picked" Preview="true" />
            </div>
            <div class="text-center sm:text-left">
                <span class="inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-extrabold text-amber-900 border border-amber-200">✨ Tonight's Selection</span>
                <h3 class="mt-2 text-2xl font-extrabold text-stone-800">@picked.Title</h3>
                <p class="mt-1 text-xs font-semibold text-stone-500">Status: <span class="text-amber-700">@picked.Status</span></p>
                <button @onclick="StartPicked"
                        class="mt-4 rounded-xl bg-emerald-700 px-4 py-2 text-xs font-extrabold text-white shadow-md transition hover:bg-emerald-800">
                    ▶ Start Working On This
                </button>
            </div>
        </div>
    }
</section>

@if (InProgress.Count > 0)
{
    <section class="mt-10">
        <h2 class="mb-4 text-lg font-extrabold text-stone-800">Currently In Progress 🏃</h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
            @foreach (var item in InProgress)
            {
                <MediaCard Item="item" OnChanged="Refresh" OnDelete="Delete" />
            }
        </div>
    </section>
}

@code {
    private static readonly string[] PickTypes = { "All", "Movie", "Game" };

    private List<MediaItem> items = new();
    private MediaItem? picked;
    private bool noBacklog;
    private bool rolling;
    private string pickType = "All";

    protected override void OnInitialized() => Refresh();

    private void Refresh() => items = Tracker.GetAllMedia().ToList();

    private async Task Pick()
    {
        rolling = true;
        await Task.Delay(400);
        picked = Tracker.GetRandomBacklogItem(pickType);
        noBacklog = picked is null;
        rolling = false;
    }

    private void StartPicked()
    {
        if (picked is null) return;
        picked.ChangeStatus("In Progress");
        picked = null;
        Refresh();
    }

    private void Delete(MediaItem item)
    {
        Tracker.RemoveMedia(item.Id);
        Refresh();
    }

    private int Count(string status) => items.Count(i => i.Status == status);
    private int Percent => items.Count == 0 ? 0 : Count("Completed") * 100 / items.Count;
    private int MovieCount => items.Count(i => i is Movie);
    private int GameCount => items.Count(i => i is VideoGame);
    private List<MediaItem> InProgress => items.Where(i => i.Status == "In Progress").ToList();

    private IEnumerable<(string Label, int Value, string Icon)> Stats => new[]
    {
        ("Total Items", items.Count, "📚"),
        ("Backlog", Count("Backlog"), "🕒"),
        ("In Progress", Count("In Progress"), "▶"),
        ("Completed", Count("Completed"), "✅")
    };

    private static string Chip(bool active) => active
        ? "rounded-xl bg-amber-700 px-3.5 py-1.5 text-xs font-extrabold text-white shadow-xs transition"
        : "rounded-xl bg-white border border-stone-300 px-3.5 py-1.5 text-xs font-bold text-stone-700 transition hover:bg-amber-100 hover:text-amber-950";
}