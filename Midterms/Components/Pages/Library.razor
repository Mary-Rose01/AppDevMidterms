@page "/library"
@rendermode InteractiveServer
@using Midterms.Models
@using Midterms.Services
@inject MediaTrackerService Tracker

<PageTitle>PopcornVault • Library</PageTitle>

<div class="mb-8 flex flex-col gap-1">
    <h1 class="text-3xl font-bold tracking-tight text-white">Library</h1>
    <p class="text-zinc-400">@Filtered.Count() of @items.Count titles</p>
</div>

<!-- Search + filters -->
<div class="mb-8 space-y-4">
    <input type="text" @bind="search" @bind:event="oninput" placeholder="Search by title…"
           class="w-full rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 outline-none transition focus:border-violet-500 focus:ring-2 focus:ring-violet-500/30 sm:max-w-sm" />

    <div class="flex flex-wrap items-center gap-2">
        @foreach (var t in Types)
        {
            var type = t;
            <button @onclick="() => typeFilter = type"
                    class="@Chip(typeFilter == type)">@type</button>
        }
        <span class="mx-1 h-5 w-px bg-zinc-800"></span>
        @foreach (var s in StatusFilters)
        {
            var status = s;
            <button @onclick="() => statusFilter = status"
                    class="@Chip(statusFilter == status)">@status</button>
        }
    </div>
</div>

@if (!Filtered.Any())
{
    <div class="rounded-2xl border border-dashed border-zinc-800 py-20 text-center text-zinc-500">
        Nothing matches your filters.
    </div>
}
else
{
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in Filtered)
        {
            <article class="group flex flex-col rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5 transition duration-300 hover:-translate-y-1 hover:border-violet-500/50 hover:shadow-xl hover:shadow-violet-500/10">
                <div class="flex items-center justify-between gap-2">
                    <span class="rounded-full bg-violet-500/10 px-2.5 py-0.5 text-xs font-medium text-violet-300 ring-1 ring-inset ring-violet-500/20">
                        @item.GetMediaBadge()
                    </span>
                    <span class="rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset @StatusClass(item.Status)">
                        @item.Status
                    </span>
                </div>

                <h3 class="mt-4 text-lg font-semibold leading-snug text-white transition group-hover:text-violet-300">
                    @item.Title
                </h3>

                <div class="mt-2 space-y-1 text-sm text-zinc-400">
                    @if (item is Movie m)
                    {
                        <p>🎬 @m.Director</p>
                        <p>⏱ @m.RuntimeMinutes min</p>
                    }
                    else if (item is VideoGame g)
                    {
                        <p>🎮 @g.Platform</p>
                    }
                </div>

                <button @onclick="() => Advance(item)"
                        class="mt-5 w-full rounded-lg border border-zinc-700 py-2 text-xs font-medium text-zinc-300 transition hover:border-violet-500 hover:bg-violet-500/10 hover:text-white">
                    Mark as @NextStatus(item.Status) →
                </button>
            </article>
        }
    </div>
}

@code {
    private static readonly string[] Types = { "All", "Movie", "Game" };
    private static readonly string[] StatusFilters = { "All", "Backlog", "In Progress", "Completed" };
    private static readonly string[] Cycle = { "Backlog", "In Progress", "Completed" };

    private List<MediaItem> items = new();
    private string search = "";
    private string typeFilter = "All";
    private string statusFilter = "All";

    protected override void OnInitialized() => items = Tracker.GetAllMedia().ToList();

    private IEnumerable<MediaItem> Filtered => items.Where(i =>
        (typeFilter == "All" || (typeFilter == "Movie" && i is Movie) || (typeFilter == "Game" && i is VideoGame)) &&
        (statusFilter == "All" || i.Status == statusFilter) &&
        (string.IsNullOrWhiteSpace(search) || i.Title.Contains(search, StringComparison.OrdinalIgnoreCase)));

    private static string NextStatus(string current) =>
        Cycle[(Array.IndexOf(Cycle, current) + 1) % Cycle.Length];

    private void Advance(MediaItem item) => item.Status = NextStatus(item.Status);

    private static string Chip(bool active) => active
        ? "rounded-full bg-violet-600 px-3.5 py-1.5 text-xs font-semibold text-white transition"
        : "rounded-full border border-zinc-700 px-3.5 py-1.5 text-xs font-medium text-zinc-400 transition hover:border-zinc-500 hover:text-white";

    private static string StatusClass(string status) => status switch
    {
        "Completed"   => "bg-emerald-500/10 text-emerald-400 ring-emerald-500/20",
        "In Progress" => "bg-amber-500/10 text-amber-400 ring-amber-500/20",
        _             => "bg-sky-500/10 text-sky-400 ring-sky-500/20"
    };
}
