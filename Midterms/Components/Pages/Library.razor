@page "/library"
@rendermode InteractiveServer
@using Midterms.Models
@using Midterms.Services
@inject MediaTrackerService Tracker

<PageTitle>Library • PopcornVault</PageTitle>

@{ var shown = Filtered.ToList(); }

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-stone-800">Media Vault 📚</h1>
        <p class="mt-1 text-xs font-semibold text-stone-500">Showing @shown.Count of @items.Count saved titles</p>
    </div>

    <div class="flex items-center gap-2">
        <input type="text" @bind="search" @bind:event="oninput" placeholder="🔍 Search titles..."
               class="w-full rounded-xl border border-stone-300 bg-white px-4 py-2 text-xs font-bold text-stone-800 placeholder-stone-400 shadow-xs outline-none transition focus:border-amber-500 focus:ring-2 focus:ring-amber-200 sm:w-60" />
        <select @bind="sort"
                class="rounded-xl border border-stone-300 bg-white px-3 py-2 text-xs font-bold text-stone-800 shadow-xs outline-none transition focus:border-amber-500">
            <option value="Newest">✨ Newest First</option>
            <option value="Title">🔤 Title (A–Z)</option>
            <option value="Rating">⭐ Top Rated</option>
        </select>
    </div>
</div>

<div class="mb-6 flex flex-wrap items-center gap-2 border-b border-stone-200 pb-4">
    @foreach (var t in Types)
    {
        var type = t;
        <button @onclick="() => typeFilter = type" class="@Chip(typeFilter == type)">
            @type <span class="ml-1 opacity-70 text-[10px]">(@TypeCount(type))</span>
        </button>
    }
    <span class="mx-1 h-4 w-px bg-stone-300"></span>
    @foreach (var s in StatusFilters)
    {
        var status = s;
        <button @onclick="() => statusFilter = status" class="@Chip(statusFilter == status)">
            @status <span class="ml-1 opacity-70 text-[10px]">(@StatusCount(status))</span>
        </button>
    }
</div>

@if (items.Count == 0)
{
    <div class="rounded-2xl border border-dashed border-amber-300 bg-white py-20 text-center shadow-xs">
        <p class="text-4xl">🍿</p>
        <p class="mt-3 text-sm font-bold text-stone-700">Your library is currently empty.</p>
        <a href="add" class="mt-4 inline-block rounded-xl bg-amber-700 px-5 py-2 text-xs font-extrabold text-white transition hover:bg-amber-800 shadow-xs">
            ＋ Add First Entry
        </a>
    </div>
}
else if (shown.Count == 0)
{
    <div class="rounded-2xl border border-dashed border-amber-300 bg-white py-16 text-center shadow-xs">
        <p class="text-3xl">🔎</p>
        <p class="mt-2 text-xs font-bold text-stone-600">No media matches your filter criteria.</p>
        <button @onclick="ClearFilters" class="mt-3 rounded-xl bg-amber-200 px-4 py-1.5 text-xs font-extrabold text-amber-950 hover:bg-amber-300 transition">
            Reset Filters
        </button>
    </div>
}
else
{
    <div class="grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4">
        @foreach (var item in shown)
        {
            <MediaCard Item="item" OnChanged="Refresh" OnDelete="Delete" />
        }
    </div>
}

@code {
    private static readonly string[] Types = { "All", "Movie", "Game" };
    private static readonly string[] StatusFilters = { "All", "Backlog", "In Progress", "Completed" };

    private List<MediaItem> items = new();
    private string search = "";
    private string typeFilter = "All";
    private string statusFilter = "All";
    private string sort = "Newest";

    protected override void OnInitialized() => Refresh();

    private void Refresh() => items = Tracker.GetAllMedia().ToList();

    private void Delete(MediaItem item)
    {
        Tracker.RemoveMedia(item.Id);
        Refresh();
    }

    private void ClearFilters()
    {
        search = "";
        typeFilter = "All";
        statusFilter = "All";
    }

    private IEnumerable<MediaItem> Filtered
    {
        get
        {
            var q = items.Where(i =>
                (typeFilter == "All" || (typeFilter == "Movie" && i is Movie) || (typeFilter == "Game" && i is VideoGame)) &&
                (statusFilter == "All" || i.Status == statusFilter) &&
                (string.IsNullOrWhiteSpace(search) || i.Title.Contains(search, StringComparison.OrdinalIgnoreCase)));

            return sort switch
            {
                "Title"  => q.OrderBy(i => i.Title, StringComparer.OrdinalIgnoreCase),
                "Rating" => q.OrderByDescending(i => i.Rating).ThenBy(i => i.Title),
                _        => q.OrderByDescending(i => i.AddedOn)
            };
        }
    }

    private int TypeCount(string type) => type switch
    {
        "Movie" => items.Count(i => i is Movie),
        "Game"  => items.Count(i => i is VideoGame),
        _       => items.Count
    };

    private int StatusCount(string status) => status == "All" ? items.Count : items.Count(i => i.Status == status);

    private static string Chip(bool active) => active
        ? "rounded-xl bg-amber-700 px-3.5 py-1.5 text-xs font-extrabold text-white shadow-xs transition"
        : "rounded-xl bg-white border border-stone-300 px-3.5 py-1.5 text-xs font-bold text-stone-700 transition hover:bg-amber-100 hover:text-amber-950";
}