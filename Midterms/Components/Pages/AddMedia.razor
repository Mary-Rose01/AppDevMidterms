@page "/add"
@rendermode InteractiveServer
@using Midterms.Models
@using Midterms.Services
@inject MediaTrackerService Tracker
@inject NavigationManager Nav

<PageTitle>Add Media • PopcornVault</PageTitle>

<div class="mb-6">
    <h1 class="text-3xl font-extrabold tracking-tight text-stone-800">Add New Entry ✨</h1>
    <p class="mt-1 text-xs font-semibold text-stone-500">Fill in details to save a movie or video game to your library.</p>
</div>

<div class="grid gap-8 lg:grid-cols-5">

    <div class="space-y-5 rounded-2xl border border-amber-900/15 bg-white p-6 shadow-xs lg:col-span-3">

        <div>
            <label class="@Label">Media Type</label>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var t in new[] { "Movie", "Game" })
                {
                    var opt = t;
                    <button type="button" @onclick="() => type = opt" class="@Tile(type == opt)">
                        @(opt == "Movie" ? "🎬 Movie" : "🎮 Video Game")
                    </button>
                }
            </div>
        </div>

        <div>
            <label class="@Label">Title</label>
            <input type="text" @bind="title" @bind:event="oninput" placeholder="e.g. Interstellar" class="@Input" />
        </div>

        <div>
            <label class="@Label">Genre</label>
            <input type="text" list="genre-options" @bind="genre" @bind:event="oninput" placeholder="e.g. Sci-Fi" class="@Input" />
            <datalist id="genre-options">
                @foreach (var g in Genres)
                {
                    <option value="@g"></option>
                }
            </datalist>
        </div>

        <div>
            <label class="@Label">Status</label>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var s in Statuses)
                {
                    var opt = s;
                    <button type="button" @onclick="() => status = opt" class="@Tile(status == opt)">@opt</button>
                }
            </div>
        </div>

        @if (type == "Movie")
        {
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="@Label">Director</label>
                    <input type="text" @bind="director" @bind:event="oninput" placeholder="e.g. Christopher Nolan" class="@Input" />
                </div>
                <div>
                    <label class="@Label">Runtime (Minutes)</label>
                    <input type="number" min="1" @bind="runtime" @bind:event="oninput" class="@Input" />
                </div>
            </div>
        }
        else
        {
            <div>
                <label class="@Label">Platform</label>
                <select @bind="platform" class="@Input">
                    @foreach (var p in Platforms)
                    {
                        <option>@p</option>
                    }
                </select>
            </div>
        }

        <div>
            <label class="@Label">Poster Image URL <span class="normal-case text-stone-400">(Optional: https link)</span></label>
            <input type="text" @bind="posterUrl" @bind:event="oninput" placeholder="https://images.unsplash.com/..." class="@Input" />
        </div>

        <div>
            <label class="@Label">Rating <span class="normal-case text-stone-400">(Optional)</span></label>
            <div class="flex gap-1">
                @foreach (var n in Enumerable.Range(1, 5))
                {
                    var star = n;
                    <button type="button" @onclick="() => rating = rating == star ? 0 : star"
                            class="text-2xl leading-none transition hover:scale-125 @(star <= rating ? "text-amber-500" : "text-stone-300")">★</button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="rounded-xl bg-rose-100 border border-rose-200 px-4 py-2 text-xs font-bold text-rose-800">@error</p>
        }

        <button type="button" @onclick="Save"
                class="w-full rounded-xl bg-amber-700 py-3 font-extrabold text-white shadow-md transition hover:bg-amber-800 active:scale-95 text-xs">
            Save To Vault 💖
        </button>
    </div>

    <aside class="lg:col-span-2">
        <div class="lg:sticky lg:top-24">
            <p class="mb-3 text-center text-xs font-extrabold uppercase tracking-wider text-amber-900">Live Card Preview</p>
            <div class="mx-auto w-52 sm:w-60">
                <MediaCard Item="BuildItem()" Preview="true" />
            </div>
        </div>
    </aside>
</div>

@code {
    private const string Label = "mb-1 block text-xs font-extrabold uppercase tracking-wider text-stone-600";
    private const string Input =
        "w-full rounded-xl border border-stone-300 bg-stone-50 px-3.5 py-2.5 text-xs font-bold text-stone-800 placeholder-stone-400 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-2 focus:ring-amber-200";

    private static readonly string[] Statuses = { "Backlog", "In Progress", "Completed" };
    private static readonly string[] Platforms = { "PC", "PlayStation", "Xbox", "Nintendo Switch", "Mobile" };
    private static readonly string[] Genres =
    {
        "Action", "Adventure", "Animation", "Comedy", "Drama", "Horror",
        "Platformer", "Roguelike", "RPG", "Sci-Fi", "Thriller"
    };

    private string type = "Movie";
    private string title = "";
    private string genre = "";
    private string status = "Backlog";
    private string director = "";
    private int runtime = 120;
    private string platform = "PC";
    private string posterUrl = "";
    private int rating;
    private string? error;

    private MediaItem BuildItem() => type == "Movie"
        ? new Movie
        {
            Title = title.Trim(), Status = status, Genre = genre.Trim(), PosterUrl = posterUrl.Trim(), Rating = rating,
            Director = director.Trim(), RuntimeMinutes = runtime
        }
        : new VideoGame
        {
            Title = title.Trim(), Status = status, Genre = genre.Trim(), PosterUrl = posterUrl.Trim(), Rating = rating,
            Platform = platform
        };

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(title))
        {
            error = "Please provide a title for the media item.";
            return;
        }

        Tracker.AddMedia(BuildItem());
        Nav.NavigateTo("/library");
    }

    private static string Tile(bool active) => active
        ? "rounded-xl border-2 border-amber-600 bg-amber-100 px-3 py-2 text-xs font-extrabold text-amber-900 transition shadow-xs"
        : "rounded-xl border border-stone-300 bg-stone-50 px-3 py-2 text-xs font-bold text-stone-600 transition hover:bg-amber-50 hover:text-amber-900";
}